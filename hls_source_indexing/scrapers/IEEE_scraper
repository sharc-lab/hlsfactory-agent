import time
import json
import re
from typing import Dict, List
import requests
import pandas as pd


BASE = "https://ieeexplore.ieee.org"
SEARCH_PAGE = f"{BASE}/search/searchresult.jsp?queryText=HLS"
REST_URL = f"{BASE}/rest/search"

UA = ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
      "(KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36")

PAGE_HEADERS = {
    "User-Agent": UA,
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.9",
    "Referer": BASE + "/",
}

XHR_HEADERS = {
    "User-Agent": UA,
    "Accept": "application/json, text/plain, */*",
    "Accept-Language": "en-US,en;q=0.9",
    "Content-Type": "application/json",
    "Origin": BASE,
    "Referer": SEARCH_PAGE,
    "X-Requested-With": "XMLHttpRequest",
}

# Your venues
VENUES = [
    "ISFPGA", "FCCM", "FPL", "FPT", "HEART",
    "ICCAD", "DAC", "ASP-DAC", "DATE", "MLCAD", "ICLAD", "GLVLSI", "HOST",
    "ISCA", "MICRO", "HPCA", "ESWEEK", "MLSYS", "ASPLOS",
    "TRETS", "TCAD",
]

# Common aliases to recognize the venue in publicationTitle (case-insensitive substring)
VENUE_ALIASES: Dict[str, List[str]] = {
    "ISFPGA": ["fpga", "field-programmable gate arrays"],
    "FCCM": ["fccm", "field-programmable custom computing machines"],
    "FPL": ["fpl", "field-programmable logic and applications"],
    "FPT": ["fpt", "field-programmable technology"],
    "HEART": ["heart", "high-performance embedded architectures and compilers"],  # HEART naming varies
    "ICCAD": ["iccad", "international conference on computer-aided design"],
    "DAC": ["dac", "design automation conference"],
    "ASP-DAC": ["asp-dac", "asia and south pacific design automation"],
    "DATE": ["date", "design, automation & test in europe"],
    "MLCAD": ["mlcad", "machine learning for cad"],
    "ICLAD": ["iclad"],  # may be rare; keep acronym
    "GLVLSI": ["glvlsi", "great lakes symposium on vlsi"],
    "HOST": ["host", "hardware-oriented security and trust"],
    "ISCA": ["isca", "international symposium on computer architecture"],
    "MICRO": ["micro", "international symposium on microarchitecture"],
    "HPCA": ["hpca", "high performance computer architecture"],
    "ESWEEK": ["embedded systems week", "cases", "emsoft", "codes+isss", "esweek"],
    "MLSYS": ["mlsys", "machine learning and systems"],
    "ASPLOS": ["asplos", "architectural support for programming languages and operating systems"],
    "TRETS": ["trets", "transactions on reconfigurable technology and systems"],  # ACM (likely 0 on IEEE)
    "TCAD": ["tcad", "ieee transactions on computer-aided design of integrated circuits and systems"],
}

def pub_matches(venue: str, pub_title: str) -> bool:
    """Return True if publicationTitle looks like the expected venue."""
    if not pub_title:
        return False
    pt = pub_title.lower()
    for alias in VENUE_ALIASES.get(venue, [venue.lower()]):
        if alias in pt:
            return True
    return False

def build_payload(venue: str, page_number: int) -> dict:
    # Query HLS plus common permutations of "high-level synthesis"
    # - ASCII hyphen vs space
    # - Case variants
    # - Common Unicode hyphens: en dash (–), non-breaking hyphen (-)
    query = (
        'HLS OR '
        '"High-Level Synthesis" OR "high-level synthesis" OR '
        '"High Level Synthesis" OR "high level synthesis" OR '
        '"High–Level Synthesis" OR "high–level synthesis" OR '   # en dash (U+2013)
        '"High-Level Synthesis" OR "high-level synthesis" OR '   # non-breaking hyphen (U+2011)
        '"High-Level-Synthesis" OR "high-level-synthesis" OR '
        '"High-level Synthesis" OR "High level-synthesis"'
    )
    # Use matchPubs so the venue token is considered in publication matching;
    # also include the venue token in the queryText to bias the results.
    return {
        "newsearch": True,
        "queryText": f"{venue} ({query})",
        "highlight": False,
        "returnFacets": ["ALL"],
        "returnType": "SEARCH",
        "pageNumber": page_number,
        "matchPubs": True,
        "rowsPerPage": 100,  # 25 default; 100 reduces page count
    }

def parse_record(rec: dict, fallback_venue: str) -> dict:
    title = rec.get("articleTitle") or ""
    # Authors list of dicts, pick preferredName/name
    names = []
    for a in rec.get("authors", []) or []:
        nm = a.get("preferredName") or a.get("name") or a.get("full_name") or a.get("lastName")
        if nm:
            names.append(nm)
    authors = ", ".join(names)
    # Year
    year = rec.get("publicationYear")
    if not year:
        # try parsing from publicationDate
        m = re.search(r"\b(19|20)\d{2}\b", str(rec.get("publicationDate", "")))
        year = m.group(0) if m else ""
    # Link: DOI preferred
    doi = rec.get("doi")
    if doi:
        link = f"https://doi.org/{doi}"
    else:
        link = ""
        if rec.get("documentLink"):
            link = f"{BASE}{rec['documentLink']}"
        elif rec.get("articleNumber"):
            link = f"{BASE}/document/{rec['articleNumber']}"
    venue_name = rec.get("publicationTitle") or fallback_venue
    return {
        "Title": title,
        "Authors": authors,
        "Year": str(year) if year else "",
        "Link": link,
        "Venue": venue_name,
    }

def main():
    s = requests.Session()

    # 1) Warm-up: GET the search page to establish cookies
    r0 = s.get(SEARCH_PAGE, headers=PAGE_HEADERS, timeout=30)
    print("Warm-up GET:", r0.status_code)
    time.sleep(1)

    results = []

    for venue in VENUES:
        print(f"\n=== Searching venue: {venue} ===")
        page = 1
        total_collected_for_venue = 0

        while True:
            payload = build_payload(venue, page)
            r = s.post(REST_URL, headers=XHR_HEADERS, json=payload, timeout=30)
            if r.status_code != 200:
                print(f"[WARN] {venue} page {page} -> HTTP {r.status_code}")
                # if 418/403 etc, back off a bit and try next venue
                break

            data = r.json()
            records = data.get("records") or []
            if not records:
                if page == 1:
                    print(f"[INFO] No results on first page for {venue}.")
                break

            for rec in records:
                pub_title = rec.get("publicationTitle") or ""
                # keep only those whose publication looks like this venue
                if pub_matches(venue, pub_title):
                    results.append(parse_record(rec, fallback_venue=venue))
                    total_collected_for_venue += 1

            # paging heuristic: if fewer than requested, probably last page
            if len(records) < payload["rowsPerPage"]:
                break

            page += 1
            time.sleep(1.0)  # be polite

        print(f"[OK] {venue}: collected {total_collected_for_venue} records.")

    # De-duplicate (Title, Venue, Year)
    seen = set()
    deduped = []
    for r in results:
        key = (r["Title"].strip().lower(), r["Venue"].strip().lower(), r["Year"])
        if key not in seen:
            seen.add(key)
            deduped.append(r)

    df = pd.DataFrame(deduped, columns=["Title", "Authors", "Year", "Link", "Venue"])
    df.to_excel("hls_papers_ieee_rest.xlsx", index=False)
    print(f"\nDone. Saved {len(deduped)} rows to hls_papers_ieee_rest.xlsx")

if __name__ == "__main__":
    main()
