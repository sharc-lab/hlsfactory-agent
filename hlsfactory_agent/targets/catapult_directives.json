{
  "array_partition.complete.local": "directive set /{top}/{var}:rsc -MAP_TO_MODULE {{[Register]}}",
  "array_partition.complete.argument": "directive set /{top}/{var}:rsc -BLOCK_SIZE 1",
  "array_partition.cyclic.local": "directive set /{top}/{var}:rsc -INTERLEAVE {factor}",
  "array_partition.block.local": "directive set /{top}/{var}:rsc -BLOCK_SIZE {block_size}",
  "array_partition.block.argument": "directive set /{top}/{var}:rsc -BLOCK_SIZE {block_size}"
}
