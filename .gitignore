exp/paper_filter/runs/*/work/*/run_area/home/
exp/paper_filter/runs/*/work/*/run_area/tools/
exp/paper_filter/runs/*/registry.sqlite
exp/paper_filter/runs/*/_github_cache/
exp/paper_filter/runs/*/run.log
exp/paper_filter/runs/*/run.pid

