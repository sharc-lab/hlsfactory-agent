# Paper PDFs (publisher-copyrighted, do not commit)
exp/paper_filter/pdfs/
# Run outputs are committed, except copies of paper text (PDF, extracted pages, agent
# transcripts, which quote whole pages) and bulky internal caches
exp/paper_filter/runs/**/*.pdf
exp/paper_filter/runs/*/work/*/run_area/pages/
