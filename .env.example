# Required: OpenRouter key for the agent model (deepseek/deepseek-v4-flash)
OPENROUTER_API_KEY=your_openrouter_key
# Strongly recommended: read-only GitHub token (no scopes needed); raises the API limit from
# 60 to 5000 requests/hour and is required for code search
GITHUB_TOKEN=your_github_token
# Optional: Exa web search (https://exa.ai), about $0.007 per query; without it agents skip web search
EXA_KEY=your_exa_key
